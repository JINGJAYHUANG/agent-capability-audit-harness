{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/acah/golden-suite.schema.json",
  "title": "Agent Capability Golden Suite",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "title", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "suite_id": {"type": "string"},
    "title": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "objective", "untrusted_input", "budgets", "actions"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "objective": {"type": "string"},
          "untrusted_input": {"type": "string"},
          "budgets": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_observations": {"type": "integer", "minimum": 0},
              "max_output_bytes": {"type": "integer", "minimum": 0},
              "max_duration_ms": {"type": "integer", "minimum": 0}
            }
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "capability", "parameters", "expected_verdict", "expected_observation"],
              "properties": {
                "id": {"type": "string"},
                "capability": {"type": "string"},
                "parameters": {"type": "object"},
                "expected_verdict": {"enum": ["allow", "ask", "deny"]},
                "expected_observation": {"enum": ["action_executed", "approval_requested", "action_blocked"]}
              }
            }
          }
        }
      }
    }
  }
}
