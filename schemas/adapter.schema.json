{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/acah/adapter.schema.json",
  "title": "Agent Capability Audit Adapter",
  "type": "object",
  "required": ["schema_version", "adapter_id", "version", "kind", "declared_capabilities"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "adapter_id": {"type": "string"},
    "version": {"type": "string"},
    "kind": {"enum": ["fixture", "replay", "command"]},
    "declared_capabilities": {"type": "array", "items": {"type": "string"}},
    "observation_file": {"type": "string"},
    "command": {"type": "array", "items": {"type": "string"}},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "env_allowlist": {"type": "array", "items": {"type": "string"}},
    "network_enforcement": {"enum": ["not_enforced", "external"]},
    "maturity": {"type": "string"}
  }
}
