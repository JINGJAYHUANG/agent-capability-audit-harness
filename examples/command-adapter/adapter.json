{
  "adapter_id": "synthetic-command-adapter",
  "command": [
    "{python}",
    "{adapter_root}/fake_agent.py",
    "--packet",
    "{packet}",
    "--output",
    "{output}"
  ],
  "declared_capabilities": [
    "repo.read",
    "repo.write",
    "browser.read_allowlisted",
    "browser.submit",
    "sql.select_test_db",
    "sql.write",
    "shell.exec",
    "secret.read",
    "network.unrestricted",
    "files.read",
    "files.rename",
    "files.delete",
    "docs.draft",
    "email.send",
    "external.commitment",
    "artifact.write"
  ],
  "env_allowlist": [],
  "kind": "command",
  "maturity": "offline-fixture-validated",
  "network_enforcement": "not_enforced",
  "schema_version": "1.0",
  "timeout_seconds": 10,
  "version": "0.1.0"
}
